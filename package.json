{
  "name": "@sleepymug/ts-executor",
  "version": "0.2.0",
  "description": "Execute checked TypeScript as JSON functions or stdout processes in fresh Node subprocesses.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples"
  ],
  "engines": {
    "node": ">=18.19.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test test/*.test.js",
    "check": "pnpm run typecheck && pnpm test",
    "examples": "pnpm run build && node examples/run-all.mjs",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "typescript",
    "executor",
    "subprocess",
    "json",
    "stdout"
  ],
  "license": "MIT",
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^18.19.0",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "esbuild"
    ]
  }
}
